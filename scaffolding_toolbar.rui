  <macros>
    <macro_item guid="a1b2c3d4-2222-4aaa-b222-000000000001">
      <text>
        <locale_1033>RSBarSnap</locale_1033>
      </text>
      <tooltip>
        <locale_1033>Snap a new bar onto an existing bar at contact distance</locale_1033>
      </tooltip>
      <script>! _-ScriptEditor _R "rs_bar_snap.py"</script>
    </macro_item>
    <macro_item guid="a1b2c3d4-2222-4aaa-b222-000000000002">
      <text>
        <locale_1033>RSBarBrace</locale_1033>
      </text>
      <tooltip>
        <locale_1033>Add a brace bar between two existing bars</locale_1033>
      </tooltip>
      <script>! _-ScriptEditor _R "rs_bar_brace.py"</script>
    </macro_item>
    <macro_item guid="a1b2c3d4-2222-4aaa-b222-000000000012">
      <text>
        <locale_1033>RSBarSubfloor</locale_1033>
      </text>
      <tooltip>
        <locale_1033>Add a subfloor bar between two existing bars with independent left/right joint pairs</locale_1033>
      </tooltip>
      <script>! _-ScriptEditor _R "rs_bar_subfloor.py"</script>
    </macro_item>
    <macro_item guid="a1b2c3d4-2222-4aaa-b222-000000000003">
      <text>
        <locale_1033>RSJointPlace</locale_1033>
      </text>
      <tooltip>
        <locale_1033>Place connector blocks on one bar pair</locale_1033>
      </tooltip>
      <script>! _-ScriptEditor _R "rs_joint_place.py"</script>
    </macro_item>
    <macro_item guid="a1b2c3d4-2222-4aaa-b222-000000000021">
      <text>
        <locale_1033>RSGroundPlace</locale_1033>
      </text>
      <tooltip>
        <locale_1033>Anchor a ground joint to a bar at a picked point (auto-jr aligns block +Y to world up)</locale_1033>
      </tooltip>
      <script>! _-ScriptEditor _R "rs_ground_place.py"</script>
    </macro_item>
    <macro_item guid="a1b2c3d4-2222-4aaa-b222-000000000011">
      <text>
        <locale_1033>RSJointEdit</locale_1033>
      </text>
      <tooltip>
        <locale_1033>Re-edit the orientation of a previously placed joint pair</locale_1033>
      </tooltip>
      <script>! _-ScriptEditor _R "rs_joint_edit.py"</script>
    </macro_item>
    <macro_item guid="a1b2c3d4-2222-4aaa-b222-000000000022">
      <text>
        <locale_1033>RSBarEdit</locale_1033>
      </text>
      <tooltip>
        <locale_1033>Color bars by length, select-by-length, batch resize about midpoint</locale_1033>
      </tooltip>
      <script>! _-ScriptEditor _R "rs_bar_edit.py"</script>
    </macro_item>
    <macro_item guid="a1b2c3d4-2222-4aaa-b222-000000000015">
      <text>
        <locale_1033>RSIKKeyframe</locale_1033>
      </text>
      <tooltip>
        <locale_1033>Dual-arm IK keyframe: pick two male joints, solve IK, save on shared Ln bar</locale_1033>
      </tooltip>
      <script>! _-ScriptEditor _R "rs_ik_keyframe.py"</script>
    </macro_item>
    <macro_item guid="a1b2c3d4-2222-4aaa-b222-000000000017">
      <text>
        <locale_1033>RSIKKeyframeAll</locale_1033>
      </text>
      <tooltip>
        <locale_1033>Right-click companion of RSIKKeyframe: multi-select bars, auto-place each robot base a standoff behind the grabbed-joint center (projected to the ground, opposite the insertion direction), then Save-base-and-exit or solve IK once per bar. Solved bars turn orange, failed bars magenta; a popup tallies the result. Retry failed bars with the single-bar RSIKKeyframe.</locale_1033>
      </tooltip>
      <script>! _-ScriptEditor _R "rs_ik_keyframe_all.py"</script>
    </macro_item>
    <macro_item guid="a1b2c3d4-2222-4aaa-b222-000000000016">
      <text>
        <locale_1033>RSShowBarActionPlan</locale_1033>
      </text>
      <tooltip>
        <locale_1033>Left-click: view a bar's IK keyframes (Enter cycles M1-M4 poses + M4-home), with its base frame drawn. Right-click: load the bar's planned motion (&lt;bar&gt;.solved_motion.json) if needed and step through the M1..M4 trajectory from the command line (Enter/Next/Prev/Jump; viewport stays free to zoom).</locale_1033>
      </tooltip>
      <script>! _-ScriptEditor _R "rs_show_bar_action_plan.py"</script>
    </macro_item>
    <macro_item guid="a1b2c3d4-2222-4aaa-b222-000000000044">
      <text>
        <locale_1033>RSShowBarActionPlanMotion</locale_1033>
      </text>
      <tooltip>
        <locale_1033>Right-click companion of RSShowBarActionPlan: pick a bar, load its planned motion if not cached, and step through the trajectory from the command line.</locale_1033>
      </tooltip>
      <script>! _-ScriptEditor _R "rs_show_bar_action_plan_motion.py"</script>
    </macro_item>
    <macro_item guid="a1b2c3d4-2222-4aaa-b222-000000000010">
      <text>
        <locale_1033>RSSequenceEdit</locale_1033>
      </text>
      <tooltip>
        <locale_1033>Interactive assembly sequence viewer and editor</locale_1033>
      </tooltip>
      <script>! _-ScriptEditor _R "rs_sequence_edit.py"</script>
    </macro_item>
    <macro_item guid="a1b2c3d4-2222-4aaa-b222-000000000008">
      <text>
        <locale_1033>RSCreateBar</locale_1033>
      </text>
      <tooltip>
        <locale_1033>Register selected curves as scaffolding bars</locale_1033>
      </tooltip>
      <script>! _-ScriptEditor _R "rs_create_bar.py"</script>
    </macro_item>
    <macro_item guid="a1b2c3d4-2222-4aaa-b222-00000000001a">
      <text>
        <locale_1033>RSRemoveBar</locale_1033>
      </text>
      <tooltip>
        <locale_1033>Remove selected bar(s) and clean up all associated joints and tool instances</locale_1033>
      </tooltip>
      <script>! _-ScriptEditor _R "rs_remove_bar.py"</script>
    </macro_item>
    <macro_item guid="a1b2c3d4-2222-4aaa-b222-00000000001b">
      <text>
        <locale_1033>RSExportRobotCell</locale_1033>
      </text>
      <tooltip>
        <locale_1033>Save the loaded RobotCell to &lt;root&gt;/RobotCell.json (compas json_dump)</locale_1033>
      </tooltip>
      <script>! _-ScriptEditor _R "rs_export_robotcell.py"</script>
    </macro_item>
    <macro_item guid="a1b2c3d4-2222-4aaa-b222-000000000050">
      <text>
        <locale_1033>RSAssignAndShowWalkableGround</locale_1033>
      </text>
      <tooltip>
        <locale_1033>Pick a bar to view + edit which WalkableGround brep(s) its robot base may stand on. Shows the assigned ground(s) and the default mobile-base placement as a half-transparent ghost robot, then asks whether to change the assignment; if yes, select brep(s) to overwrite and it re-shows. Auto-assigns the nearest ground if the bar has none.</locale_1033>
      </tooltip>
      <script>! _-ScriptEditor _R "rs_assign_and_show_walkable_ground.py"</script>
    </macro_item>
    <macro_item guid="a1b2c3d4-2222-4aaa-b222-000000000051">
      <text>
        <locale_1033>RSSelectBar</locale_1033>
      </text>
      <tooltip>
        <locale_1033>Type a bar id like B4 (case-insensitive; a bare number works too) to select and zoom to that bar's centerline + tube preview. Comma-separate ids (B4,B7) to select several; the prompt loops so you can jump between bars. Read-only.</locale_1033>
      </tooltip>
      <script>! _-ScriptEditor _R "rs_select_bar.py"</script>
    </macro_item>
    <macro_item guid="a1b2c3d4-2222-4aaa-b222-000000000053">
      <text>
        <locale_1033>RSTempPlace</locale_1033>
      </text>
      <tooltip>
        <locale_1033>TEMPORARY (mock-up workflow): for every male / ground joint that has no female yet, create a 200 mm stub bar centred under where its female belongs. Choose PlaceFemaleJointBar (bar + the mating female half) or PlaceBar (the bar only, same length and position). Ground joints have no mate frame in joint_pairs.json, so you pick which pair's male plug they mate like. Stub bars are marked FAKE, so they sequence and the IK still sees their joints, but the prefab / bar-action / robot-cell exports skip them. Check stubs near subfloor joints by eye - a stub can pass straight through another bar.</locale_1033>
      </tooltip>
      <script>! _-ScriptEditor _R "rs_temp_place.py"</script>
    </macro_item>
    <macro_item guid="a1b2c3d4-2222-4aaa-b222-00000000001d">
      <text>
        <locale_1033>RSExportBarAction</locale_1033>
      </text>
      <tooltip>
        <locale_1033>Left-click: pick a bar; save its assembly cycle (M0-M4) to &lt;root&gt;/BarActions/&lt;bar_id&gt;.json. Right-click: export EVERY bar (IK optional) + RobotCell.json + WalkableGround.json (for the headless base+IK solver).</locale_1033>
      </tooltip>
      <script>! _-ScriptEditor _R "rs_export_bar_action.py"</script>
    </macro_item>
    <macro_item guid="a1b2c3d4-2222-4aaa-b222-00000000001f">
      <text>
        <locale_1033>RSExportAllBarActions</locale_1033>
      </text>
      <tooltip>
        <locale_1033>Export BarAssemblyAction JSON for EVERY bar (IK optional), plus RobotCell.json + WalkableGround.json, to &lt;root&gt;. Bars without IK are solved later by the headless base+IK sampler.</locale_1033>
      </tooltip>
      <script>! _-ScriptEditor _R "rs_export_all_bar_actions.py"</script>
    </macro_item>
    <macro_item guid="a1b2c3d4-2222-4aaa-b222-000000000040">
      <text>
        <locale_1033>RSClearIKKeyframe</locale_1033>
      </text>
      <tooltip>
        <locale_1033>Left-click: pick ONE bar, then choose what to erase via two toggles -- Keyframe (M1-M3 arm IK config) and BasePosition (mobile base), both default Erase. Untick one to keep it (e.g. keep the base to re-solve at the same spot). Right-click: same, but applies to EVERY bar. M4 home config is a constant, left untouched.</locale_1033>
      </tooltip>
      <script>! _-ScriptEditor _R "rs_clear_ik_keyframe.py"</script>
    </macro_item>
    <macro_item guid="a1b2c3d4-2222-4aaa-b222-000000000041">
      <text>
        <locale_1033>RSClearIKKeyframeAll</locale_1033>
      </text>
      <tooltip>
        <locale_1033>Right-click companion of RSClearIKKeyframe: apply the clear to EVERY registered bar, then choose what to erase via the same two toggles (Keyframe / BasePosition, both default Erase).</locale_1033>
      </tooltip>
      <script>! _-ScriptEditor _R "rs_clear_ik_keyframe_all.py"</script>
    </macro_item>
    <macro_item guid="a1b2c3d4-2222-4aaa-b222-000000000042">
      <text>
        <locale_1033>RSLoadSolvedBarAction</locale_1033>
      </text>
      <tooltip>
        <locale_1033>Left-click: pick a bar; load its headless-solved &lt;bar&gt;.solved_&lt;kind&gt;.json (prompts keyframe vs motion), sync its IK back onto the bar user-text, and open RSShowBarActionPlan to view it. Right-click: load ALL solved bar actions in BarActions/ and draw every bar's base frame (step with NextBar/PrevBar).</locale_1033>
      </tooltip>
      <script>! _-ScriptEditor _R "rs_load_solved_bar_action.py"</script>
    </macro_item>
    <macro_item guid="a1b2c3d4-2222-4aaa-b222-000000000043">
      <text>
        <locale_1033>RSLoadSolvedBarActionAll</locale_1033>
      </text>
      <tooltip>
        <locale_1033>Right-click companion of RSLoadSolvedBarAction: load EVERY &lt;bar&gt;.solved_&lt;kind&gt;.json in BarActions/, sync each to user-text, and open RSShowBarActionPlan showing all bars' base frames (the assembly-wide standing-position map).</locale_1033>
      </tooltip>
      <script>! _-ScriptEditor _R "rs_load_solved_bar_action_all.py"</script>
    </macro_item>
    <macro_item guid="a1b2c3d4-2222-4aaa-b222-000000000006">
      <text>
        <locale_1033>RSMeasureGap</locale_1033>
      </text>
      <tooltip>
        <locale_1033>Measure the shortest distance between two bars</locale_1033>
      </tooltip>
      <script>! _-ScriptEditor _R "rs_measure_gap.py"</script>
    </macro_item>
    <macro_item guid="a1b2c3d4-2222-4aaa-b222-000000000009">
      <text>
        <locale_1033>RSUpdatePreview</locale_1033>
      </text>
      <tooltip>
        <locale_1033>Refresh all bar tube previews</locale_1033>
      </tooltip>
      <script>! _-ScriptEditor _R "rs_update_preview.py"</script>
    </macro_item>
    <macro_item guid="a1b2c3d4-2222-4aaa-b222-000000000045">
      <text>
        <locale_1033>RSClearColorPreview</locale_1033>
      </text>
      <tooltip>
        <locale_1033>Right-click companion of RSUpdatePreview: clear every color preview -- IK bar colors, broken-link colors, and the orange marker dots -- and unselect. Left-click RSUpdatePreview offers UpdatePreview (repair) and ShowColorsPreview (paint them again).</locale_1033>
      </tooltip>
      <script>! _-ScriptEditor _R "rs_clear_color_preview.py"</script>
    </macro_item>
    <macro_item guid="a1b2c3d4-2222-4aaa-b222-000000000023">
      <text>
        <locale_1033>RSReorderBarID</locale_1033>
      </text>
      <tooltip>
        <locale_1033>Renumber every bar so B&lt;n&gt; matches assembly sequence n; updates joints, grounds, and tools to match</locale_1033>
      </tooltip>
      <script>! _-ScriptEditor _R "rs_reorder_bar_id.py"</script>
    </macro_item>
    <macro_item guid="a1b2c3d4-2222-4aaa-b222-00000000000a">
      <text>
        <locale_1033>RSExportPrefab</locale_1033>
      </text>
      <tooltip>
        <locale_1033>Export bar prefabrication data as JSON</locale_1033>
      </tooltip>
      <script>! _-ScriptEditor _R "rs_export_prefab.py"</script>
    </macro_item>
    <macro_item guid="a1b2c3d4-2222-4aaa-b222-000000000070">
      <text>
        <locale_1033>RSImportScaffoldJSON</locale_1033>
      </text>
      <tooltip>
        <locale_1033>Import a node/rod/coupler scaffolding JSON: one registered bar per rod (bar_id = B&lt;rod_id&gt;), sequenced by layer_id then rod_id, with coupler_list and every other field stored for the round trip</locale_1033>
      </tooltip>
      <script>! _-ScriptEditor _R "rs_import_scaffold_json.py"</script>
    </macro_item>
    <macro_item guid="a1b2c3d4-2222-4aaa-b222-000000000071">
      <text>
        <locale_1033>RSExportScaffoldJSON</locale_1033>
      </text>
      <tooltip>
        <locale_1033>Export the current bars back to the same node/rod/coupler JSON schema; nodes follow the bars' snapped positions, coupler_list is carried over plus any joints placed in Rhino</locale_1033>
      </tooltip>
      <script>! _-ScriptEditor _R "rs_export_scaffold_json.py"</script>
    </macro_item>
    <macro_item guid="a1b2c3d4-2222-4aaa-b222-000000000072">
      <text>
        <locale_1033>RSSetRodLayer</locale_1033>
      </text>
      <tooltip>
        <locale_1033>Select bars (centerlines or tube previews) and assign their layer_id: 0 also sets grounded true, 1/2/... set grounded false. Both fields go straight into rod_list on the next RSExportScaffoldJSON</locale_1033>
      </tooltip>
      <script>! _-ScriptEditor _R "rs_set_rod_layer.py"</script>
    </macro_item>
    <macro_item guid="a1b2c3d4-2222-4aaa-b222-00000000000b">
      <text>
        <locale_1033>RSDefineJointHalf</locale_1033>
      </text>
      <tooltip>
        <locale_1033>Define one joint half (Male / Female / Ground) from baked Rhino geometry</locale_1033>
      </tooltip>
      <script>! _-ScriptEditor _R "rs_define_joint_half.py"</script>
    </macro_item>
    <macro_item guid="a1b2c3d4-2222-4aaa-b222-000000000020">
      <text>
        <locale_1033>RSDefineJointMate</locale_1033>
      </text>
      <tooltip>
        <locale_1033>Define a mate between two existing joint halves</locale_1033>
      </tooltip>
      <script>! _-ScriptEditor _R "rs_define_joint_mate.py"</script>
    </macro_item>
    <macro_item guid="a1b2c3d4-2222-4aaa-b222-00000000000c">
      <text>
        <locale_1033>RSDefineRoboticTool</locale_1033>
      </text>
      <tooltip>
        <locale_1033>AssemblyTool mode: define a tool candidate (block + TCP points + picked collision meshes, exports .3dm + .obj). SupportGripper mode: export bar-grasp to tool0 transform</locale_1033>
      </tooltip>
      <script>! _-ScriptEditor _R "rs_define_robotic_tool.py"</script>
    </macro_item>
    <macro_item guid="a1b2c3d4-2222-4aaa-b222-00000000000d">
      <text>
        <locale_1033>RSPBStop</locale_1033>
      </text>
      <tooltip>
        <locale_1033>Disconnect the shared PyBullet client</locale_1033>
      </tooltip>
      <script>! _-ScriptEditor _R "rs_pb_stop.py"</script>
    </macro_item>
    <macro_item guid="a1b2c3d4-2222-4aaa-b222-00000000000f">
      <text>
        <locale_1033>RSBakeFrame</locale_1033>
      </text>
      <tooltip>
        <locale_1033>Bake a right-handed frame from three picked points (origin, +X, +Y)</locale_1033>
      </tooltip>
      <script>! _-ScriptEditor _R "rs_bake_frame.py"</script>
    </macro_item>
    <macro_item guid="a1b2c3d4-2222-4aaa-b222-000000000018">
      <text>
        <locale_1033>RSSwapRoboticTool</locale_1033>
      </text>
      <tooltip>
        <locale_1033>Type a registered tool name to activate its L/R pair (imports tool definitions, re-places existing tools, prompts a cell rebuild)</locale_1033>
      </tooltip>
      <script>! _-ScriptEditor _R "rs_swap_robotic_tool.py"</script>
    </macro_item>
    <macro_item guid="a1b2c3d4-2222-4aaa-b222-000000000052">
      <text>
        <locale_1033>RSInspectRoboticTool</locale_1033>
      </text>
      <tooltip>
        <locale_1033>Open a PyBullet viewer to inspect all robotic tool candidates: slide through L/R pairs (L at origin, R at +0.30 m), see each tool0 + TCP frame, and delete a whole candidate pair (entries + .3dm/.obj) with a two-step confirm</locale_1033>
      </tooltip>
      <script>! _-ScriptEditor _R "rs_inspect_robotic_tool.py"</script>
    </macro_item>
    <macro_item guid="a1b2c3d4-2222-4aaa-b222-000000000019">
      <text>
        <locale_1033>RSPBStart</locale_1033>
      </text>
      <tooltip>
        <locale_1033>Left-click: start the shared PyBullet client in Direct (headless) mode. Right-click: start it in GUI mode.</locale_1033>
      </tooltip>
      <script>! _-ScriptEditor _R "rs_pb_start.py"</script>
    </macro_item>
    <macro_item guid="a1b2c3d4-2222-4aaa-b222-00000000002b">
      <text>
        <locale_1033>RSPBStartGUI</locale_1033>
      </text>
      <tooltip>
        <locale_1033>Start the shared PyBullet client for IK/FK workflows in GUI mode</locale_1033>
      </tooltip>
      <script>! _-ScriptEditor _R "rs_pb_start_gui.py"</script>
    </macro_item>
    <macro_item guid="a1b2c3d4-2222-4aaa-b222-00000000002a">
      <text>
        <locale_1033>RSRebuildRobotCell</locale_1033>
      </text>
      <tooltip>
        <locale_1033>(Re)build the static assembly collision cell (bars + joints + environment obstacles + arm ToolModels). Run after adding/moving/resizing geometry.</locale_1033>
      </tooltip>
      <script>! _-ScriptEditor _R "rs_rebuild_robot_cell.py"</script>
    </macro_item>
    <macro_item guid="a1b2c3d4-2222-4aaa-b222-00000000001e">
      <text>
        <locale_1033>RSExportBarTool0TF</locale_1033>
      </text>
      <tooltip>
        <locale_1033>Pick a bar; export bar-OCF -&gt; tool0_left/right transforms to &lt;root&gt;/BarTool0TF/&lt;bar_id&gt;.json</locale_1033>
      </tooltip>
      <script>! _-ScriptEditor _R "rs_export_bar_tool0_tf.py"</script>
    </macro_item>
    <macro_item guid="a1b2c3d4-2222-4aaa-b222-000000000060">
      <text>
        <locale_1033>RSRegisterAliases</locale_1033>
      </text>
      <tooltip>
        <locale_1033>Register a typeable command alias for every RS* toolbar macro, so you can type e.g. RSDefineRoboticTool in the command line instead of clicking a button. Run once per machine; re-run after macro changes. Aliases persist across Rhino sessions.</locale_1033>
      </tooltip>
      <script>! _-ScriptEditor _R "register_command_aliases.py"</script>
    </macro_item>
    <macro_item guid="a1b2c3d4-2222-4aaa-b222-000000000030">
      <text>
        <locale_1033>RSReadMoCapBar</locale_1033>
      </text>
      <tooltip>
        <locale_1033>Read one OptiTrack rigid body and bake its labeled markers as Rhino points on the MoCap_Retrieval layer</locale_1033>
      </tooltip>
      <script>! _-ScriptEditor _R "rs_read_mocap_bar.py"</script>
    </macro_item>
    <macro_item guid="a1b2c3d4-2222-4aaa-b222-000000000031">
      <text>
        <locale_1033>RSAlignModelThreeBars</locale_1033>
      </text>
      <tooltip>
        <locale_1033>Align all managed-layer geometry by fitting three model bars to three baked mocap lines</locale_1033>
      </tooltip>
      <script>! _-ScriptEditor _R "rs_align_model_three_bars.py"</script>
    </macro_item>
    <macro_item guid="87856446-3dda-4fba-9033-a40435439586">
      <text>
        <locale_1033>RSSequenceRenumber</locale_1033>
      </text>
      <tooltip>
        <locale_1033>renumber bar_id</locale_1033>
      </tooltip>
      <script>! _-ScriptEditor _Run "rs_sequence_renumber.py"</script>
    </macro_item>
    <macro_item guid="08f0999d-5d7c-4120-9244-85f08ff82f3c">
      <text>
        <locale_1033>RSSequencePreview</locale_1033>
      </text>
      <tooltip>
        <locale_1033>preview bar sequence</locale_1033>
      </tooltip>
      <script>! _-ScriptEditor _R "rs_sequence_preview.py"</script>
    </macro_item>
    <macro_item guid="79dba12b-fb85-4168-a86c-796546386f74">
      <text>
        <locale_1033>RSSequenceRenumber</locale_1033>
      </text>
      <tooltip>
        <locale_1033>renumber bar sequence</locale_1033>
      </tooltip>
      <script>! _-ScriptEditor _R "rs_sequence_renumber.py"</script>
    </macro_item>
  </macros>
